#!/command/with-contenv bash
# Mission Control dashboard (enabled via MC_ENABLE=true)
#
# Uses with-contenv shebang to load ALL env vars from the top-level
# /run/s6/container_environment/ dir (written there by persist_env_var
# in 25-setup-mission-control). This avoids the MC_ prefix directory
# whose permissions get reset by 99999-apply-permissions.

if [ "${MC_ENABLE:-false}" != "true" ]; then
  echo "[mission-control] Disabled (set MC_ENABLE=true to enable)"
  s6-svc -Od .
  exit 0
fi

# Configure Tailscale Serve for HTTPS access (wait for Tailscale to be ready)
if [ "${TAILSCALE_ENABLE:-false}" = "true" ] && command -v tailscale >/dev/null 2>&1; then
  MC_PORT="${MC_PORT:-3333}"
  # Wait for the gateway to establish its tailscale serve rule first.
  # The gateway sets resetOnExit=true which clears ALL serve rules on
  # start/stop — if we add ours before the gateway is ready, it gets wiped.
  GATEWAY_PORT="${GATEWAY_PORT:-18789}"
  (
    # Phase 1: wait for gateway's serve rule to appear (up to 120s)
    echo "[mission-control] Waiting for gateway tailscale serve on port $GATEWAY_PORT..."
    for i in $(seq 1 120); do
      if tailscale serve status 2>/dev/null | grep -q "$GATEWAY_PORT"; then
        echo "[mission-control] Gateway serve detected, adding MC serve rule"
        break
      fi
      [ "$i" -eq 120 ] && echo "[mission-control] WARNING: Gateway serve not detected after 120s, trying anyway"
      sleep 1
    done
    # Phase 2: add MC serve rule (retry up to 30s in case of transient errors)
    for i in $(seq 1 30); do
      if tailscale serve --bg --https="$MC_PORT" "http://127.0.0.1:$MC_PORT" 2>/dev/null; then
        echo "[mission-control] Tailscale HTTPS serve configured on port $MC_PORT"
        exit 0
      fi
      sleep 1
    done
    echo "[mission-control] WARNING: Failed to configure Tailscale serve after retries"
  ) &
fi

echo "[mission-control] Starting on port ${MC_PORT:-3333}..."

# Use runuser -l to get openclaw's login shell (loads nvm/PATH for node).
# Pass env vars explicitly since runuser -l starts a clean environment.
exec runuser -l openclaw -c "\
  export MC_PORT='${MC_PORT:-3333}' \
  GATEWAY_PORT='${GATEWAY_PORT:-18789}' \
  OPENCLAW_GATEWAY_TOKEN='${OPENCLAW_GATEWAY_TOKEN}' \
  OPENCLAW_STATE_DIR='${OPENCLAW_STATE_DIR:-/data/.openclaw}' \
  SLACK_BOT_TOKEN='${SLACK_BOT_TOKEN}' \
  MC_SLACK_NOTIFY_CHANNEL='${MC_SLACK_NOTIFY_CHANNEL}'; \
  exec node /opt/mission-control/server/dist/index.js" 2>&1
