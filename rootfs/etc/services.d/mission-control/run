#!/bin/bash
# Mission Control dashboard (enabled via MC_ENABLE=true)
source /etc/s6-overlay/lib/env-utils.sh

# Read MC_ vars as root (99999-apply-permissions resets MC_ files to root:root 0600,
# so the openclaw user can't read them — we must source them here while still root)
source_env_prefix MC_

if [ "${MC_ENABLE:-false}" != "true" ]; then
  echo "[mission-control] Disabled (set MC_ENABLE=true to enable)"
  s6-svc -Od .
  exit 0
fi

# Configure Tailscale Serve for HTTPS access (if Tailscale is running)
if [ "${TAILSCALE_ENABLE:-false}" = "true" ] && command -v tailscale >/dev/null 2>&1; then
  MC_PORT="${MC_PORT:-3333}"
  tailscale serve --bg --https="$MC_PORT" "http://127.0.0.1:$MC_PORT" 2>/dev/null || true
fi

echo "[mission-control] Starting on port ${MC_PORT:-3333}..."

# Export vars explicitly (sourced as root above) then drop to openclaw user
export MC_PORT="${MC_PORT:-3333}"
export MC_ENABLE="${MC_ENABLE}"
export OPENCLAW_GATEWAY_TOKEN="${OPENCLAW_GATEWAY_TOKEN}"
export OPENCLAW_STATE_DIR="${OPENCLAW_STATE_DIR:-/data/.openclaw}"
export OPENCLAW_WORKSPACE_DIR="${OPENCLAW_WORKSPACE_DIR:-/data/workspace}"
export GATEWAY_PORT="${GATEWAY_PORT:-18789}"
exec /command/s6-setuidgid openclaw node /opt/mission-control/server/dist/index.js
