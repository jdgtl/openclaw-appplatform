#!/command/with-contenv bash
# Generate openclaw gateway configuration
source /etc/s6-overlay/lib/env-utils.sh

set -e
source_env_prefix OPENCLAW_

# OpenClaw requires any env vars consumed in config to exist or else it fails to start.
persist_env_var OPENCLAW_ \
  GRADIENT_API_KEY=change-me \
  HTTP_PROXY="http://127.0.0.1:1055" \
  HTTPS_PROXY="http://127.0.0.1:1055" \
  NO_PROXY="localhost,127.0.0.1" \
  BRAVE_API_KEY="${BRAVE_API_KEY}" \
  GH_TOKEN="${GH_TOKEN}" \
  ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY}" \
  ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL}" \
  OPENAI_API_KEY="${OPENAI_API_KEY}" \
  OPENAI_BASE_URL="${OPENAI_BASE_URL}" \
  NOTION_API_KEY="${NOTION_API_KEY}" \
  CLICKUP_API_TOKEN="${CLICKUP_API_TOKEN}" \
  GOG_KEYRING_PASSWORD="${GOG_KEYRING_PASSWORD}" \
  CLAUDE_RUNNER_TOKEN="${CLAUDE_RUNNER_TOKEN}" \
  MAILCHIMP_API_KEY="${MAILCHIMP_API_KEY}" \
  EBAY_CLIENT_ID="${EBAY_CLIENT_ID}" \
  EBAY_CLIENT_SECRET="${EBAY_CLIENT_SECRET}" \
  EBAY_ENVIRONMENT="${EBAY_ENVIRONMENT:-production}" \
  EBAY_REDIRECT_URI="${EBAY_REDIRECT_URI}" \
  HEARTBEAT_INTERVAL="${HEARTBEAT_INTERVAL:-0m}" \
  TAILSCALE_ENABLE="${TAILSCALE_ENABLE:-false}" \
  SLACK_ENABLE="${SLACK_ENABLE:-false}" \
  SLACK_BOT_TOKEN="${SLACK_BOT_TOKEN}" \
  SLACK_APP_TOKEN="${SLACK_APP_TOKEN}" \
  SLACK_ACCOUNT_NAME="${SLACK_ACCOUNT_NAME}" \
  SLACK_BOT_TOKEN_2="${SLACK_BOT_TOKEN_2}" \
  SLACK_APP_TOKEN_2="${SLACK_APP_TOKEN_2}" \
  SLACK_ACCOUNT_2_NAME="${SLACK_ACCOUNT_2_NAME}" \
  TS_SOCKET="${TS_SOCKET}" \
  TS_EXTRA_ARGS="${TS_EXTRA_ARGS}" \
  TS_HOSTNAME="${TS_HOSTNAME}" \
  TS_STATE_DIR="${TS_STATE_DIR}" \
  TS_USERSPACE="${TS_USERSPACE}" \
  OPENCLAW_AUTO_UPDATE="${OPENCLAW_AUTO_UPDATE:-false}" \
  OPENCLAW_STATE_DIR=/data/.openclaw \
  OPENCLAW_WORKSPACE_DIR=/data/workspace

# Ensure directories exist (only if variables are set)
[ -n "$OPENCLAW_STATE_DIR" ] && mkdir -p "$OPENCLAW_STATE_DIR"
[ -n "$OPENCLAW_WORKSPACE_DIR" ] && mkdir -p "$OPENCLAW_WORKSPACE_DIR"

# Validate mutual exclusivity of ngrok and tailscale
if [ "${ENABLE_NGROK:-false}" = "true" ] && [ "${TAILSCALE_ENABLE:-false}" = "true" ]; then
  echo "[generate-config] WARNING: Both ENABLE_NGROK and TAILSCALE_ENABLE are true."
  echo "[generate-config] This doesn't make sense - ngrok is public, Tailscale is private."
  echo "[generate-config] Defaulting to Tailscale (disable ENABLE_NGROK to silence this)."
fi

# Setup openclaw user's .profile (used by login shells, no interactive check)
SOURCE_LINE="source /etc/s6-overlay/lib/env-utils.sh"
PROFILE="/home/openclaw/.profile"
# Create .profile if it doesn't exist
touch "$PROFILE"
chown openclaw:openclaw "$PROFILE"
# Append environment setup if not already present
if ! grep -qF "$SOURCE_LINE" "$PROFILE"; then
    cat >> "$PROFILE" <<'EOF'
# OpenClaw environment setup
source /etc/s6-overlay/lib/env-utils.sh 2>/dev/null || true
source_env_prefix OPENCLAW_ 2>/dev/null || true

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
EOF
    echo "Appended environment setup to $PROFILE"
fi

# Configure Claude Code to use Aperture proxy (if ANTHROPIC_BASE_URL is set)
if [ -n "$ANTHROPIC_BASE_URL" ]; then
  CLAUDE_CONFIG_DIR="/home/openclaw/.claude"
  CLAUDE_SETTINGS="$CLAUDE_CONFIG_DIR/settings.json"
  mkdir -p "$CLAUDE_CONFIG_DIR"
  cat > "$CLAUDE_SETTINGS" <<CEOF
{
  "apiKeyHelper": "echo '-'",
  "env": {
    "ANTHROPIC_BASE_URL": "$ANTHROPIC_BASE_URL"
  }
}
CEOF
  chown -R openclaw:openclaw "$CLAUDE_CONFIG_DIR"
  echo "[generate-config] Claude Code configured to use Aperture at $ANTHROPIC_BASE_URL"
fi

DEFAULT_CONFIG="/etc/openclaw/openclaw.default.json"
CONFIG_FILE="$OPENCLAW_STATE_DIR/openclaw.json"

echo "[generate-config] Building config: $CONFIG_FILE"

# Auto-update OpenClaw at startup (set OPENCLAW_AUTO_UPDATE=true for latest, or a specific version)
if [ -n "${OPENCLAW_AUTO_UPDATE}" ] && [ "${OPENCLAW_AUTO_UPDATE}" != "false" ]; then
  CURRENT_VER=$(su - openclaw -c 'source $HOME/.profile && openclaw --version' 2>/dev/null || echo 'unknown')
  if [ "${OPENCLAW_AUTO_UPDATE}" = "true" ] || [ "${OPENCLAW_AUTO_UPDATE}" = "latest" ]; then
    TARGET_VER="latest"
  else
    TARGET_VER="${OPENCLAW_AUTO_UPDATE}"
  fi
  echo "[generate-config] Auto-update enabled: current=$CURRENT_VER, target=$TARGET_VER"
  if su - openclaw -c "source \$HOME/.profile && HTTP_PROXY= HTTPS_PROXY= NO_PROXY= pnpm add -g openclaw@${TARGET_VER} --package-import-method=copy" 2>&1; then
    echo "[generate-config] OpenClaw updated successfully"
  else
    echo "[generate-config] WARNING: OpenClaw update failed, continuing with installed version" >&2
  fi
fi

# Show version
echo "[generate-config] Checking openclaw installation..."
if ! command -v openclaw >/dev/null 2>&1; then
  echo "[generate-config] ERROR: openclaw command not found in PATH" >&2
  echo "[generate-config] PATH: $PATH" >&2
  echo "[generate-config] Node version: $(node --version 2>&1 || echo 'not found')" >&2
  exit 1
fi

echo "[generate-config] OpenClaw version: $(openclaw --version 2>/dev/null || echo 'unknown')"

# Generate a gateway token if not provided
if [ -z "$OPENCLAW_GATEWAY_TOKEN" ]; then
  OPENCLAW_GATEWAY_TOKEN=$(head -c 32 /dev/urandom | base64 | tr -d '=/+' | head -c 32)
  echo "[generate-config] Generated gateway token (ephemeral): $OPENCLAW_GATEWAY_TOKEN"
  echo "[generate-config] Save this token - you'll need it to connect to the Control UI"
fi

# Write token to s6 environment
persist_env_var OPENCLAW_ OPENCLAW_GATEWAY_TOKEN="$OPENCLAW_GATEWAY_TOKEN"
echo "[generate-config] Gateway token configured (OPENCLAW_GATEWAY_TOKEN)"

# Use existing config if restored from backup, otherwise start from default
if [ -f "$CONFIG_FILE" ] && [ -s "$CONFIG_FILE" ]; then
  echo "[generate-config] Using existing config (restored from backup)"
else
  if [ -f "$DEFAULT_CONFIG" ]; then
    cp "$DEFAULT_CONFIG" "$CONFIG_FILE"
    echo "[generate-config] Using default config from $DEFAULT_CONFIG"
  else
    # Fallback minimal config if default doesn't exist
    echo '{"gateway": {"mode": "local"}}' > "$CONFIG_FILE"
    echo "[generate-config] Warning: Default config not found, using minimal config"
  fi
fi

# OpenClaw strips managed sections (channels, commands, plugins, meta) from
# openclaw.json after loading them into internal state. The .bak file created
# by OpenClaw preserves the full config before stripping. Merge any sections
# from .bak that are missing in the stripped config so they survive deploys.
if [ -f "${CONFIG_FILE}.bak" ] && [ -s "${CONFIG_FILE}.bak" ]; then
  BAK_KEYS=$(jq -r 'keys | length' "${CONFIG_FILE}.bak" 2>/dev/null || echo 0)
  MAIN_KEYS=$(jq -r 'keys | length' "$CONFIG_FILE" 2>/dev/null || echo 0)
  if [ "$BAK_KEYS" -gt "$MAIN_KEYS" ]; then
    echo "[generate-config] Merging stripped sections from .bak ($BAK_KEYS keys) into config ($MAIN_KEYS keys)"
    # .bak as base, main config overlaid on top (main config wins for shared keys)
    jq -s '.[0] * .[1]' "${CONFIG_FILE}.bak" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
  fi
fi

# Handle ENABLE_UI flag - disable Control UI if set to false
if [ "${ENABLE_UI:-true}" = "false" ]; then
  echo "[generate-config] Disabling Control UI (ENABLE_UI=false)"
  jq '.gateway.controlUi.enabled = false' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
fi

# Add Tailscale config when enabled
if [ "${TAILSCALE_ENABLE:-false}" = "true" ]; then
  echo "[generate-config] Adding Tailscale serve config"
  jq '.gateway.tailscale.resetOnExit = true | .gateway.tailscale.mode = "serve" | .gateway.auth.allowTailscale = true' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
fi

# Add Slack channel config when enabled
if [ "${SLACK_ENABLE:-false}" = "true" ]; then
  if [ -n "$SLACK_BOT_TOKEN" ] && [ -n "$SLACK_APP_TOKEN" ]; then
    # Multi-account: if second workspace tokens are present, use accounts structure
    if [ -n "$SLACK_BOT_TOKEN_2" ] && [ -n "$SLACK_APP_TOKEN_2" ]; then
      ACCT1="${SLACK_ACCOUNT_NAME:-default}"
      ACCT2="${SLACK_ACCOUNT_2_NAME:-account2}"
      echo "[generate-config] Adding Slack multi-account config ($ACCT1, $ACCT2)"
      jq --arg acct1 "$ACCT1" --arg bot1 "$SLACK_BOT_TOKEN" --arg app1 "$SLACK_APP_TOKEN" \
         --arg acct2 "$ACCT2" --arg bot2 "$SLACK_BOT_TOKEN_2" --arg app2 "$SLACK_APP_TOKEN_2" \
        '.plugins.entries.slack.enabled = true | .channels.slack.enabled = true | .channels.slack.mode = "socket" | .channels.slack.dmPolicy = "pairing" | .channels.slack.groupPolicy = "allowlist" | .channels.slack.replyToMode = "off" | .channels.slack.accounts[$acct1] = {"name": $acct1, "botToken": $bot1, "appToken": $app1} | .channels.slack.accounts[$acct2] = {"name": $acct2, "botToken": $bot2, "appToken": $app2}' \
        "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
    else
      # Single account: flat config
      echo "[generate-config] Adding Slack channel config (socket mode)"
      jq --arg botToken "$SLACK_BOT_TOKEN" --arg appToken "$SLACK_APP_TOKEN" \
        '.plugins.entries.slack.enabled = true | .channels.slack.enabled = true | .channels.slack.mode = "socket" | .channels.slack.botToken = $botToken | .channels.slack.appToken = $appToken | .channels.slack.dmPolicy = "pairing" | .channels.slack.groupPolicy = "allowlist" | .channels.slack.replyToMode = "off"' \
        "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
    fi
  else
    echo "[generate-config] WARNING: SLACK_ENABLE=true but SLACK_BOT_TOKEN or SLACK_APP_TOKEN not set"
  fi
fi

# Add Anthropic provider via Aperture proxy (if ANTHROPIC_BASE_URL is set)
if [ -n "$ANTHROPIC_BASE_URL" ]; then
  echo "[generate-config] Adding Anthropic provider via Aperture ($ANTHROPIC_BASE_URL)"
  jq --arg baseUrl "$ANTHROPIC_BASE_URL" --arg apiKey "${ANTHROPIC_API_KEY:--}" \
    '.models.providers.anthropic = {
      "baseUrl": $baseUrl,
      "apiKey": $apiKey,
      "api": "anthropic-messages",
      "models": [
        {"id": "claude-opus-4-6", "name": "Claude Opus 4.6", "reasoning": true, "input": ["text","image"], "contextWindow": 200000, "maxTokens": 16384},
        {"id": "claude-sonnet-4-6", "name": "Claude Sonnet 4.6", "reasoning": true, "input": ["text","image"], "contextWindow": 200000, "maxTokens": 16384},
        {"id": "claude-sonnet-4-5", "name": "Claude Sonnet 4.5", "reasoning": true, "input": ["text","image"], "contextWindow": 200000, "maxTokens": 16384},
        {"id": "claude-sonnet-4-5-20250929", "name": "Claude Sonnet 4.5 (20250929)", "reasoning": true, "input": ["text","image"], "contextWindow": 200000, "maxTokens": 16384},
        {"id": "claude-haiku-4-5", "name": "Claude Haiku 4.5", "reasoning": false, "input": ["text","image"], "contextWindow": 200000, "maxTokens": 8192},
        {"id": "claude-haiku-4-5-20251001", "name": "Claude Haiku 4.5 (20251001)", "reasoning": false, "input": ["text","image"], "contextWindow": 200000, "maxTokens": 8192}
      ]
    }' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
fi

# Add OpenAI provider via Aperture proxy (if OPENAI_BASE_URL is set)
if [ -n "$OPENAI_BASE_URL" ]; then
  echo "[generate-config] Adding OpenAI provider via Aperture ($OPENAI_BASE_URL)"
  jq --arg baseUrl "$OPENAI_BASE_URL" --arg apiKey "${OPENAI_API_KEY:--}" \
    '.models.providers.openai = {
      "baseUrl": $baseUrl,
      "apiKey": $apiKey,
      "api": "openai-completions",
      "models": [
        {"id": "gpt-5.2-chat-latest", "name": "GPT-5.2 Chat", "reasoning": false, "input": ["text","image"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5.2-codex", "name": "GPT-5.2 Codex", "reasoning": false, "input": ["text"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5.2", "name": "GPT-5.2", "reasoning": false, "input": ["text","image"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5.1-chat-latest", "name": "GPT-5.1 Chat", "reasoning": false, "input": ["text","image"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5.1-codex-max", "name": "GPT-5.1 Codex Max", "reasoning": false, "input": ["text"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5.1-codex", "name": "GPT-5.1 Codex", "reasoning": false, "input": ["text"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5.1", "name": "GPT-5.1", "reasoning": false, "input": ["text","image"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5-chat-latest", "name": "GPT-5 Chat", "reasoning": false, "input": ["text","image"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5-codex", "name": "GPT-5 Codex", "reasoning": false, "input": ["text"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5-nano", "name": "GPT-5 Nano", "reasoning": false, "input": ["text"], "contextWindow": 128000, "maxTokens": 8192},
        {"id": "gpt-5-mini", "name": "GPT-5 Mini", "reasoning": false, "input": ["text","image"], "contextWindow": 128000, "maxTokens": 16384},
        {"id": "gpt-5", "name": "GPT-5", "reasoning": false, "input": ["text","image"], "contextWindow": 128000, "maxTokens": 16384}
      ]
    }' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
fi

# Agent timeout (10 min — needed for clawdev tasks that call the Claude Code Runner)
echo "[generate-config] Setting agent timeout to 600s"
jq '.agents.defaults.timeoutSeconds = 600' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"

# Tools profile: "full" enables all tools including MCPorter/MCP
echo "[generate-config] Setting tools profile to full"
jq '.tools.profile = "full"' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"

# Add heartbeat config (disabled by default — set HEARTBEAT_INTERVAL to "30m" or "1h" to activate)
HEARTBEAT_INTERVAL="${HEARTBEAT_INTERVAL:-0m}"
echo "[generate-config] Adding heartbeat config (interval: $HEARTBEAT_INTERVAL)"
jq --arg interval "$HEARTBEAT_INTERVAL" \
  '.agents.defaults.heartbeat = {
    "every": $interval,
    "target": "last",
    "session": "main"
  }' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"

# Clean up stale top-level keys that may have been restored from backup
# These were incorrectly placed at top-level in an earlier version and cause gateway crash loops
jq 'del(.memorySearch, .contextPruning, .compaction)' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"

# Add memory search, context pruning, and compaction (memory flush) config
# These must live under agents.defaults — top-level keys are rejected by OpenClaw 2026.2.24+
echo "[generate-config] Adding memory search and compaction config"
jq '
  .agents.defaults.memorySearch = {
    "enabled": true,
    "sources": ["memory"],
    "provider": "openai",
    "sync": {
      "watch": true,
      "onSessionStart": true,
      "onSearch": true
    }
  }
  | .agents.defaults.contextPruning = {
    "mode": "cache-ttl",
    "ttl": "6h",
    "keepLastAssistants": 3
  }
  | .agents.defaults.compaction.memoryFlush = {
    "enabled": true,
    "softThresholdTokens": 40000,
    "prompt": "Distill this session to memory/YYYY-MM-DD.md. Focus on decisions, state changes, lessons, blockers. If nothing worth storing: NO_FLUSH",
    "systemPrompt": "Extract only what is worth remembering. No fluff."
  }
' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"

# Seed HEARTBEAT.md if it doesn't exist (agent can customize later via chat)
HEARTBEAT_MD="$OPENCLAW_WORKSPACE_DIR/HEARTBEAT.md"
if [ ! -f "$HEARTBEAT_MD" ]; then
  mkdir -p "$(dirname "$HEARTBEAT_MD")"
  cat > "$HEARTBEAT_MD" <<'HBEOF'
# Heartbeat Checklist

- Check if anything needs attention
- If nothing is urgent, respond with HEARTBEAT_OK
HBEOF
  chown openclaw:openclaw "$HEARTBEAT_MD"
  echo "[generate-config] Created default HEARTBEAT.md"
fi

# Seed MEMORY.md if it doesn't exist
MEMORY_MD="$OPENCLAW_WORKSPACE_DIR/MEMORY.md"
if [ ! -f "$MEMORY_MD" ]; then
  cat > "$MEMORY_MD" <<'MEMEOF'
# Memory

Use this file to record important context, decisions, and lessons learned.
MEMEOF
  chown openclaw:openclaw "$MEMORY_MD"
  echo "[generate-config] Created default MEMORY.md"
fi

# Seed IDENTITY.md if it doesn't exist
IDENTITY_MD="$OPENCLAW_WORKSPACE_DIR/IDENTITY.md"
if [ ! -f "$IDENTITY_MD" ]; then
  cat > "$IDENTITY_MD" <<'IDEOF'
# Identity

**Name:** Agent
**Role:** AI Assistant

You are a helpful AI assistant.
IDEOF
  chown openclaw:openclaw "$IDENTITY_MD"
  echo "[generate-config] Created default IDENTITY.md"
fi

# Ensure memory subdirectory exists for auto-generated memory files
mkdir -p "$OPENCLAW_WORKSPACE_DIR/memory"
chown openclaw:openclaw "$OPENCLAW_WORKSPACE_DIR/memory"

# Enable cron scheduler (required for cron tool add/update/remove to work)
echo "[generate-config] Enabling cron scheduler"
jq '.cron.enabled = true | .cron.store = "/data/.openclaw/cron/jobs.json" | .cron.maxConcurrentRuns = 5' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
mkdir -p /data/.openclaw/cron

# Add gateway auth token and trust localhost proxy (Mission Control)
echo "[generate-config] Adding gateway.auth.token to config"
# Build allowedOrigins: MC localhost + Tailscale HTTPS origins (for browser Control UI access)
# Use actual Tailscale hostname from state (restored from backup) or TS_HOSTNAME env var,
# falling back to STABLE_HOSTNAME. The TS hostname can differ from STABLE_HOSTNAME when
# manually changed via `tailscale set --hostname`.
source_env_prefix TS_
TS_TAILNET="taila801b3.ts.net"
ALLOWED_ORIGINS='["http://127.0.0.1:3333"'
_add_ts_origin() {
  local hn="$1"
  [ -z "$hn" ] && return
  local fqdn="${hn}.${TS_TAILNET}"
  # Avoid duplicates
  case "$ALLOWED_ORIGINS" in
    *"${fqdn}"*) return ;;
  esac
  ALLOWED_ORIGINS="${ALLOWED_ORIGINS}, \"https://${fqdn}\", \"https://${fqdn}:3333\""
  echo "[generate-config] Adding Tailscale origins: https://${fqdn}, https://${fqdn}:3333"
}
# Extract worker name from container hostname (e.g. clawdius-6fd984dcd9-hflkx → clawdius)
# On DO App Platform this matches the Tailscale hostname
WORKER_NAME=$(hostname | sed 's/-[a-f0-9]*-[a-z0-9]*$//')
_add_ts_origin "$WORKER_NAME"
# Also add TS_HOSTNAME (from env/persist) and STABLE_HOSTNAME as fallbacks
_add_ts_origin "${TS_HOSTNAME:-}"
_add_ts_origin "${STABLE_HOSTNAME:-}"
ALLOWED_ORIGINS="${ALLOWED_ORIGINS}]"
jq --arg token "$OPENCLAW_GATEWAY_TOKEN" --argjson origins "$ALLOWED_ORIGINS" '.gateway.auth.token = $token | .gateway.auth.mode = "token" | .gateway.trustedProxies = ["127.0.0.1"] | .gateway.controlUi.allowedOrigins = $origins' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"

# Permissions applied via /etc/digitalocean/permissions.yaml

echo "[generate-config] Final config:"
jq '.' "$CONFIG_FILE"

persist_env_var OPENCLAW_

echo "[generate-config] Done generating config"
