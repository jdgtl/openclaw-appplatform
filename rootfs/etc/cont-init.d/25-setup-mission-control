#!/command/with-contenv bash
# Setup Mission Control environment
source /etc/s6-overlay/lib/env-utils.sh

if [ "${MC_ENABLE:-false}" != "true" ]; then
  echo "[mission-control] Disabled, skipping setup"
  exit 0
fi

# Load OPENCLAW_ vars (gateway token is persisted there by 20-setup-openclaw)
source_env_prefix OPENCLAW_

# Persist MC vars + gateway token (MC service needs both)
persist_env_var MC_ \
  MC_ENABLE="${MC_ENABLE}" \
  MC_PORT="${MC_PORT:-3333}" \
  OPENCLAW_GATEWAY_TOKEN="${OPENCLAW_GATEWAY_TOKEN}" \
  OPENCLAW_STATE_DIR="${OPENCLAW_STATE_DIR:-/data/.openclaw}" \
  TAILSCALE_ENABLE="${TAILSCALE_ENABLE:-false}"

# Fix permissions so openclaw user can read MC_ env vars
# (must be done here because 99999-apply-permissions glob ordering
# may not override the root:root 0600 set by the /**/* rule)
chown -R openclaw:openclaw /run/s6/container_environment/MC_
chmod 755 /run/s6/container_environment/MC_
chmod 644 /run/s6/container_environment/MC_/*

echo "[mission-control] Setup complete (port ${MC_PORT:-3333}, token=${OPENCLAW_GATEWAY_TOKEN:+set})"
